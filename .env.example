# Supabase project settings. Get these from your Supabase project's
# Settings -> API page (https://supabase.com/dashboard/project/_/settings/api).

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never prefix with NEXT_PUBLIC_ and never commit a real value.
# Bypasses Row Level Security -- used only by trusted server-side code
# (see lib/supabase/admin.ts).
# SUPABASE_SECRET_KEY (an sb_secret_... key, as set by the Vercel Supabase
# integration) is accepted instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for the AI Assistant (lib/ai/). Create one at
# https://console.anthropic.com/settings/keys. Server-only.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Push notifications (OneSignal, https://onesignal.com). Create a Web app with
# the site URL, then copy its App ID (public) and REST API key (server-only).
# Push is shown as "not switched on" until both are set.
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# Shared secret for the reminder scheduler (app/api/cron/notifications),
# called every 15 minutes by Supabase pg_cron. Any long random string.
CRON_SECRET=a-long-random-string
